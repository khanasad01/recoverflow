# RecoverFlow Environment Configuration

# Database & Cache
DATABASE_URL=postgresql+psycopg2://recoverflow:recoverflow@localhost:5432/recoverflow
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development

# JWT Security & Auth
JWT_SECRET_KEY=recoverflow_super_secret_jwt_key_987654321_secure_enterprise
ACCESS_TOKEN_EXPIRE_MINUTES=480
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Razorpay Gateway & Webhook
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=recoverflow_webhook_secret_123

# Stripe Gateway & Webhook
STRIPE_WEBHOOK_SECRET=whsec_recoverflow_stripe_test_secret_123

# AI & Machine Learning
GEMINI_API_KEY=xxxxxxxx
# GOOGLE_API_KEY=xxxxxxxx  # Optional alias for GEMINI_API_KEY
# Note: Gemini 2.5 models are scheduled for shutdown by Google on 16 Oct 2026 — check ai.google.dev for the current stable model before then.
GEMINI_MODEL=gemini-2.5-flash
SCORING_MODEL=ml
# CONTROL_GROUP_PERCENT=10  # Note: unused, legacy from earlier A/B design

# Event Simulator (Optional / Local Testing Only)
# WEBHOOK_TARGET_URL=http://localhost:8000/webhooks/razorpay
# STRIPE_WEBHOOK_URL=http://localhost:8000/webhooks/stripe

# SendGrid Email Integration
SENDGRID_API_KEY=SG.xxxxxxxx
SENDGRID_FROM_EMAIL=no-reply@recoverflow.dev

# Twilio WhatsApp Integration
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Payment & UPI Configuration
MERCHANT_UPI_ID=recoverflow@icici
MERCHANT_NAME=RecoverFlow Merchant

# Frontend Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000
